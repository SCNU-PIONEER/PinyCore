#
# ArmorLoader config
#
CONFIG_APP_USE_DIAL=y
CONFIG_ARMORLOADER_TYPE="Dial"
CONFIG_ARMORLOADER_FILE="\"Dial.hpp\""
# end of ArmorLoader config

CONFIG_APP_USE_ARMORBOOSTER=y

#
# ArmorBooster config
#
CONFIG_APP_USE_DUAL=y
CONFIG_ARMORBOOSTER_TYPE="DualFric"
CONFIG_ARMORBOOSTER_FILE="\"DualFric.hpp\""
