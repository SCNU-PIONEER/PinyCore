{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "lldb",
      "type": "lldb",
      "request": "attach",
      "preLaunchTask": "jlinkserver",
      "targetCreateCommands": ["target create ${workspaceFolder}/build/PinyCore.elf"],
      "processCreateCommands": ["gdb-remote 127.0.0.1:50000",
                                "target modules load --load .text 0x08000000",
                                "process plugin packet monitor reset"],
    },

    {
      "name": "rtt",
      "type": "node",  //占位
      "request": "launch",
      "preLaunchTask": "open-RTT",
    },

    {
      "name": "jlink-Debug",
      "executable": "./build/PinyCore.elf",
      "type": "cortex-debug",
      "request": "launch",
      "showDevDebugOutput": "none",
      "servertype": "jlink",
      // "device": "stm32h723vg",
      "device": "stm32f407ig",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 1
      },
      "preLaunchTask": "build",
      "preLaunchCommands": [
        "source ${workspaceRoot}/tools/script/.gdbinit", 
        "set p obj on",
        "set p pretty on"
      ],
      "postLaunchCommands": [
        "b PinyCore::init",
        // "continue"
      ],
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "polling_interval": 10,
        "decoders": [
          {
            "type": "console",
            "label": "cnt",
            // "iencoding": "utf8",
            "noclear": false,
            "logfile": "${workspaceRoot}/.docs/rtt_log",
            "port": 0,
          }
        ]
      }
    },

    {
      "showDevDebugOutput": "none",
      "cwd": "${workspaceFolder}",
      "executable": "./build/PinyCore.elf",
      "name": "DebugSTM32",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      
      "configFiles": [
        //"${workspaceFolder}/tools/openocd/stlink.cfg",
        "${workspaceFolder}/tools/openocd/dap.cfg",
        // "${workspaceFolder}/tools/openocd/jlink.cfg",
        // "target/stm32h7x.cfg",
        "target/stm32f4x.cfg"
      ],
      "ToolchainPath": "/usr/bin/",
      // "svdFile": "docs/startup/STM32H723.svd",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 1
      },
      "preLaunchTask": "build",
      // "overrideLaunchCommands": [  // 不复位debug
      //     "monitor  halt",
      // ],
      //   "overrideResetCommands": [
      //     "monitor  halt",
      // ],
      // "postDebugTask": "close-RTT",
      "preLaunchCommands": [
        "source ${workspaceRoot}/tools/script/.gdbinit", // 手动加载.gdbinit文件
        "set p obj on",
        "set p pretty on"
      ],
       "postLaunchCommands": [
        "b PinyCore::init"
      ],
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "polling_interval": 10,
        "decoders": [
          {
            "type": "console",
            "label": "cnt",
            // "iencoding": "utf8",
            "noclear": false,
            "logfile": "${workspaceRoot}/docs/rtt_log",
            "port": 0,
          },
