{
  //marus25.cortex-debug
  "cortex-debug.variableUseNaturalFormat": true,
  //seunlanlege.action-buttons
  "actionButtons": {
    "defaultColor": "white", // Can also use string color names.
    "loadNpmCommands": false, // Disables automatic generation of actions for npm commands.
    "reloadButton": "↻", // Custom reload button text or icon (default ↻). null value enables automatic reload on configuration change
    "commands": [
      {
        "name": "$(trash)",
        "color": "none",
        "singleInstance": true,
        "command": "rm -r ${workspaceFolder}/build && rm .config .config.old Src/sdkconfig.cmake Src/sdkconfig.h && exit",
        "tooltip": "Remove build folder"
      },
      {
        // "cwd": "/", 	// Terminal initial folder ${workspaceFolder} and os user home as defaults
        "name": "$(tools)",
        "color": "none",
        "singleInstance": true,
        "command": "cmake -B 'build' -G 'Ninja' && ninja -C 'build' ",
        "tooltip": "Build project"
      },
      {
        "name": "$(flame)",
        "color": "none",
        "singleInstance": true,
        "command": "openocd -f interface/cmsis-dap.cfg -f target/stm32h7x.cfg  -c 'program ./build/robot.elf verify reset exit' && exit",
        "tooltip": "Build and flash project"
      },
      // {
      //     "name": "$(bug)",
      //     "color": "none",
      //     "useVsCodeApi": true,
      //     "command": "",
      //     "tooltip": "Debug project"
      // }
    ]
  },
  //OBKoro1.korofileheader
  "fileheader.customMade": {
    "FilePath": "only file name",
    "Brief": "",
    "Version": "",
    "Author": "git config user.name",
    // "Date": "Do not edit\r\n",
    // "LastEditors": "git config user.name",
    "LastEditTime": "Do not edit",
    "custom_string_obkoro1_copyright": "Copyright ${now_year} by SCNU-PIONEER (c), All Rights Reserved."
    // "custom_string_obkoro1_copyright": "Copyright (c) ${now_year} by 写死的公司名/用户名, All Rights Reserved. "
  },
  "fileheader.configObj": {
    "specialOptions": {
      "FilePath": "File",
    },
    "wideSame": true, // 设置为true开启
    "wideNum": 13, // 字段长度 默认为13
    "createHeader": true, // 默认关闭
    "switch": {
      "newlineAddAnnotation": true // 默认开启
    },
    "supportAutoLanguage": [
      "c",
      "cpp",
      "h",
      "hpp"
    ]
  }
}
