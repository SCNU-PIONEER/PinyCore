menu "utils config"
    config USE_MATHEMATICA
        bool "mathematica"
        default y
    
    source "Src/Utils/Mathematica/Kconfig"

    config USE_DWT
        bool "Dwt timer"
        default y
    config USE_FSM
        bool "Finite State Machine"
        default y
    config USE_HARDFAULT 
        bool "segger hardfault handle"
        default y
    config USE_STM_LOG
        bool "stm log"
        default y

    config LOG_OUTPUT_RTT
        bool "SEGGER RTT log output"
        default y
        depends on USE_STM_LOG

    config LOG_OUTPUT_UART
        bool "UART log output"
        default n
        depends on USE_STM_LOG
        depends on BSP_USE_UART
        depends on BSP_USE_DMA
    config USE_VOFA 
        bool "vofa"
        default y
    config USE_LAZY
        bool "lazy init"
        default y
    config USE_SINGLETON
        bool "singleton class base"
        default y
endmenu
