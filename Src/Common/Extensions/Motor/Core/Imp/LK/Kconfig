config MOTOR_LK_MF9025
    bool "MF9025"
    default n

if MOTOR_LK_MF9025

choice LK_MF9025_COMMUNICATION
    prompt "MF9025 communication"
    default MF9025_CAN

    config MF9025_CAN
        bool "CAN"
    config MF9025_RS485
        bool "RS485"
    config MF9025_CAN_BROADCAST
        bool "Can Broadcast"
    config MF9025_RS485_BROADCAST
        bool "RS485 Broadcast"
endchoice

endif

