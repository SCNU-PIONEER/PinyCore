{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "jlink-Debug",
      "executable": "./build/PinyCore.elf",
      "type": "cortex-debug",
      "request": "launch",
      "showDevDebugOutput": "none",
      "servertype": "jlink",
      "device": "stm32f103c8",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 1
      },
      "preLaunchTask": "build",
      "preLaunchCommands": [
        "source ${workspaceRoot}/tools/script/.gdbinit"
      ],
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "polling_interval": 10,
        "decoders": [
          {
            "type": "console",
            "label": "cnt",
            "noclear": false,
            "logfile": "${workspaceRoot}/.docs/rtt.log",
            "port": 0
          }
        ]
      }
    },
    {
      "showDevDebugOutput": "none",
      "cwd": "${workspaceFolder}",
      "executable": "./build/PinyCore.elf",
      "name": "dap",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "${workspaceFolder}/tools/openocd/dap.cfg",
        "target/stm32f1x.cfg"
      ],
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 1
      },
      "preLaunchTask": "build",
      "preLaunchCommands": [
        "source ${workspaceRoot}/tools/script/.gdbinit",
      ],
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "polling_interval": 10,
        "decoders": [
          {
            "type": "console",
            "label": "cnt",
            "noclear": false,
            "logfile": "${workspaceRoot}/.docs/rtt.log",
            "port": 0
          }
        ]
      }
    },
    {
      "showDevDebugOutput": "none",
      "cwd": "${workspaceFolder}",
      "executable": "./build/PinyCore.elf",
      "name": "stlink",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "${workspaceFolder}/tools/openocd/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 1
      },
      "preLaunchCommands": [
        "${workspaceRoot}/tools/script/.gdbinit",
      ],
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "polling_interval": 10,
        "decoders": [
          {
            "type": "console",
            "label": "cnt",
            "noclear": false,
            "logfile": "${workspaceRoot}/.docs/rtt.log",
            "port": 0
          }
        ]
      }
    }
  ]
}
