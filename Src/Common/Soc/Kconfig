menu "Soc config"
    choice
        prompt "Soc target choice"
        default TARGET_STM32F407

        config TARGET_STM32F407
        bool "STM32F407"

        config TARGET_STM32H723
        bool "STM32H723"

    endchoice

    if TARGET_STM32F407
        source "Src/Common/Soc/stm32f407/Kconfig"
    endif

    if TARGET_STM32H723
        source "Src/Common/Soc/stm32h723/Kconfig"
    endif


endmenu

