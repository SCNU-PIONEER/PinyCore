flowchart TD
    START["ET08A 遥控器数据处理"] --> SR{"右开关 sr<br/>(switchRight)"}

    SR -->|"DOWN ↓"| SR_DOWN["🛑 全停止<br/>Gimbal: STOP | wPitch=wYaw=0<br/>Chassis: STOP | vx=vy=0<br/>ArmorLoader: STOP | fire=false<br/>ArmorBooster: OFF"]

    SR -->|"MID 中"| COMPUTE_MID["📐 速度解算<br/>vx = ch1 / RANGE × VX_MAX<br/>vy = -ch0 / RANGE × VY_MAX<br/>wPitch = -ch3 / RANGE × PITCH_MAX<br/>wYaw = -ch2 / RANGE × YAW_MAX<br/>fire = abs(wheel - offset)/RANGE > 0.2<br/>c.wz = g.wYaw (无通讯模式)"]
    COMPUTE_MID --> SL_MID{"左开关 sl<br/>(switchLeft)"}
    SL_MID -->|"DOWN ↓"| SL_MID_D["🏃 自由模式<br/>Gimbal: RUN<br/>Chassis: RUN<br/>ArmorLoader: STOP<br/>ArmorBooster: OFF"]
    SL_MID -->|"MID 中"| SL_MID_M["🛡️ 坦克模式<br/>Gimbal: RUN<br/>Chassis: TANK<br/>ArmorBooster: ON<br/>ArmorLoader: AUTO"]
    SL_MID -->|"UP ↑"| SL_MID_U["🔄 旋转模式<br/>Chassis: SPIN<br/>⚠️ Gimbal/Loader/Booster 未设置"]

    SR -->|"UP ↑"| COMPUTE_UP["📐 速度解算<br/>（同上：ch0-ch3 + wheel 拨轮）<br/>fire = abs(wheel - offset)/RANGE > 0.2<br/>c.wz = g.wYaw (无通讯模式)"]
    COMPUTE_UP --> SL_UP{"左开关 sl<br/>(switchLeft)"}
    SL_UP -->|"DOWN ↓"| SL_UP_D["🎯 导航模式<br/>Gimbal: NAV<br/>Chassis: TANK<br/>ArmorLoader: STOP<br/>ArmorBooster: OFF"]
    SL_UP -->|"MID 中"| SL_UP_M["🎯 导航+射频<br/>Gimbal: NAV<br/>Chassis: TANK<br/>ArmorLoader: AUTO<br/>ArmorBooster: ON"]
    SL_UP -->|"UP ↑"| SL_UP_U["🔧 云台独立<br/>Chassis: STOP<br/>Gimbal: RUN<br/>ArmorLoader: STOP<br/>ArmorBooster: OFF"]

    SR_DOWN --> NOTIFY["📤 推送消息到各模块队列"]
    SL_MID_D --> NOTIFY
    SL_MID_M --> NOTIFY
    SL_MID_U --> NOTIFY
    SL_UP_D --> NOTIFY
    SL_UP_M --> NOTIFY
    SL_UP_U --> NOTIFY

    style SR_DOWN fill:#ff6b6b,color:#fff
    style SL_MID_D fill:#4ecdc4,color:#fff
    style SL_MID_M fill:#45b7d1,color:#fff
    style SL_MID_U fill:#f9ca24,color:#333
    style SL_UP_D fill:#6c5ce7,color:#fff
    style SL_UP_M fill:#a29bfe,color:#fff
    style SL_UP_U fill:#fd79a8,color:#fff
    style START fill:#00b894,color:#fff
    style NOTIFY fill:#636e72,color:#fff