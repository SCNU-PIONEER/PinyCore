CONFIG_TARGET_MASTER=y
# CONFIG_TARGET_SLAVE is not set

#
# Soc config
#
# CONFIG_TARGET_STM32F407 is not set
CONFIG_TARGET_STM32H723=y
# end of Soc config

#
# app config
#
# CONFIG_APP_USE_CHASSIS is not set
CONFIG_APP_USE_GIMBAL=y

#
# gimbal config
#
CONFIG_APP_USE_STANDARD=y
# CONFIG_APP_USE_STACKED is not set
CONFIG_GIMBAL_TYPE="Standard"
CONFIG_GIMBAL_FILE="\"Standard.hpp\""
# end of gimbal config

# CONFIG_APP_USE_ARMORLOADER is not set
CONFIG_APP_USE_ARMORBOOSTER=y

#
# ArmorBooster config
#
CONFIG_APP_USE_DUAL=y
CONFIG_ARMORBOOSTER_TYPE="DualFric"
CONFIG_ARMORBOOSTER_FILE="\"DualFric.hpp\""
# end of ArmorBooster config

# CONFIG_APP_USE_TEST is not set
CONFIG_APP_USE_INS=y

#
# INS config
#
# CONFIG_INS_ACCEL_CALIBRATION is not set
# end of INS config

CONFIG_APP_USE_DAEMONS=y
CONFIG_APP_USE_COMM=y
CONFIG_APP_USE_UI=y
# end of app config

#
# Bsp config
#
CONFIG_BSP_USE_CAN=y
CONFIG_BSP_USE_DMA=y
CONFIG_BSP_USE_PWM=y
CONFIG_BSP_USE_UART=y
CONFIG_BSP_USE_SPI=y
# CONFIG_BSP_USE_IIC is not set
CONFIG_BSP_USE_TIM=y
CONFIG_BSP_USE_USB=y
# end of Bsp config

#
# extension config
#
CONFIG_EXTENSION_DT7=y
# CONFIG_EXTENSION_ET08A is not set
CONFIG_EXTENSION_VT13=y
CONFIG_EXTENSION_BUZZER=y
CONFIG_EXTENSION_LED=y

#
# LEDDriver config
#
# CONFIG_LED_WS2812_SPI is not set
CONFIG_LED_WS2812_PWM=y
# CONFIG_LED_RGBLED is not set
# end of LEDDriver config

CONFIG_EXTENSION_MOTOR=y
CONFIG_EXTENSION_REFEREE=y
CONFIG_EXTENSION_SENSOR=y
# CONFIG_EXTENSION_SUPERCAP is not set
# CONFIG_EXTENSION_TOF is not set
# end of extension config

#
# utils config
#
CONFIG_USE_ALGORITHM=y
CONFIG_USE_DWT=y
CONFIG_USE_FSM=y
CONFIG_USE_HARDFAULT=y
CONFIG_USE_STM_LOG=y
CONFIG_USE_VOFA=y
CONFIG_USE_LAZY=y
CONFIG_USE_SINGLETON=y
# end of utils config

#
# Kernel hacking
#
CONFIG_RTOS_DEBUG=y
CONFIG_USE_VSCODE_XRTOS=y
# end of Kernel hacking
